{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-review.mjs",
  "outputDirectory": "review-deploy",
  "installCommand": "npm ci --omit=dev",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
    ]}
  ],
  "rewrites": [
    {"source": "/api/config", "destination": "/review-api/config.json"},
    {"source": "/api/availability", "destination": "/review-api/availability.json"},
    {"source": "/api/reviews", "destination": "/review-api/reviews.json"}
  ]
}
